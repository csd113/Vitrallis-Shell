# Cross-compilation environment for the established ARMv7 release contract
# (armv7-unknown-linux-gnueabihf, glibc 2.36, SDL2 2.26.5+). This stage runs on
# the build host architecture, exactly like the release workflow; it produces
# ARM binaries but never executes the target platform's GUI stack itself.
FROM rust:1.91.1-bookworm
RUN dpkg --add-architecture armhf \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc-arm-linux-gnueabihf libsdl2-dev:armhf pkg-config \
        python3 qemu-user file \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add armv7-unknown-linux-gnueabihf
ENV CARGO_TARGET_DIR=/target \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_LIBDIR=/usr/lib/arm-linux-gnueabihf/pkgconfig:/usr/share/pkgconfig
COPY build.sh stage-tests.py /opt/
WORKDIR /workspace
CMD ["/bin/sh", "/opt/build.sh"]
