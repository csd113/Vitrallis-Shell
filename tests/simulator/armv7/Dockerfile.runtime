# PocketCHIP-like ARMv7 runtime: an unprivileged user on Debian 13 armhf with
# the SDL2 runtime the release contract requires. Binaries produced by
# Dockerfile.toolchain are mounted read-only at /opt/vitrallis and executed here
# under Docker's ARM emulation. This is a software-environment simulator, not a
# physical PocketCHIP and not a GPU/kernel emulator.
FROM --platform=linux/arm/v7 arm32v7/debian:trixie
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libsdl2-2.0-0 python3 python3-venv python3-packaging ca-certificates \
        file binutils procps util-linux x11-xserver-utils \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /bin/sh chip
COPY container-run.sh /opt/vitrallis/container-run.sh
WORKDIR /opt/vitrallis
CMD ["/bin/sh", "/opt/vitrallis/container-run.sh"]
